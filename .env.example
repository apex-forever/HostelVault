# Copy this file to .env and fill in your own values

PORT=3000

# Your Neon Postgres connection string (from the Neon dashboard's "Connect" button)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Set to "true" to wipe the database and recreate the bootstrap admin +
# empty hostel structure on every server start. Leave "false" in production.
RESEED_ON_START=false

# Credentials for the one bootstrap administrator account created on first
# run. Set these to something real before your first deploy, then change the
# password from the Profile page immediately after logging in. If left
# unset, they default to admin@hostelvault.com / ChangeMe123!
ADMIN_EMAIL=admin@hostelvault.com
ADMIN_PASSWORD=ChangeMe123!
